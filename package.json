{
  "name": "replan",
  "version": "0.1.0",
  "private": true,
  "description": "Recover approved spare-parts transfers when the world changes mid-execution.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run tests/recovery.test.ts tests/simulators.test.ts",
    "evaluate": "uv run --frozen --project solver python solver/benchmark.py",
    "test:solver": "uv run --frozen --project solver python -m unittest discover -s solver/tests -v",
    "verify:export": "tsx src/replay.ts",
    "db:start": "node scripts/database.mjs start",
    "db:stop": "node scripts/database.mjs stop"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
