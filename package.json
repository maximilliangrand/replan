{
  "name": "replan",
  "version": "0.2.0",
  "private": true,
  "description": "Recover approved spare-parts transfers when the world changes mid-execution.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "tsx src/server.ts",
    "operator": "tsx scripts/operator.mts",
    "workspace": "tsx scripts/workspace.mts",
    "migrate": "tsx scripts/migrate.mts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run tests/recovery.test.ts tests/simulators.test.ts",
    "evaluate": "uv run --frozen --project solver python solver/benchmark.py",
    "test:solver": "uv run --frozen --project solver python -m unittest discover -s solver/tests -v",
    "verify:export": "tsx src/replay.ts",
    "db:start": "node scripts/database.mjs start",
    "db:stop": "node scripts/database.mjs stop",
    "backup:drill": "tsx scripts/backup-drill.mts",
    "test:browser": "npm run build && playwright test",
    "check:operations": "tsx scripts/check-operations.mts",
    "test:capacity": "tsx scripts/capacity.mts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.1",
    "prettier": "3.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
