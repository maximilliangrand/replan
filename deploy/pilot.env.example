# Copy to .local/pilot.env (ignored by Git), chmod 600, and replace placeholders.
# Secret values must come from your password manager or deployment secret store.
APP_DOMAIN=pilot.example.com
APP_ORIGIN=https://pilot.example.com
ACME_EMAIL=operator@example.com
# Space-separated office/VPN public IP CIDRs. Do not use 0.0.0.0/0 or ::/0.
PILOT_ALLOWED_CIDRS=203.0.113.10/32
REPLAN_IMAGE=replan-pilot:local

# Same application DB; runtime credentials cannot perform DDL.
DATABASE_URL=postgres://replan_runtime:REPLACE@database.example.com/replan?sslmode=verify-full
MIGRATION_DATABASE_URL=postgres://replan_owner:REPLACE@database.example.com/replan?sslmode=verify-full
INVENTORY_URL=https://inventory-adapter.example.com
CARRIER_URL=https://carrier-adapter.example.com
PROVIDER_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Optional simulation profile only. Each service owns a separate database.
# Use INVENTORY_URL=http://inventory:4311 and CARRIER_URL=http://carrier:4312.
INVENTORY_DATABASE_URL=
CARRIER_DATABASE_URL=
